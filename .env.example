# Copy to .env (local) or the deployment's environment. Never commit real values.

# ── Database ──
DATABASE_URL=
DIRECT_URL=

# ── Sessions ──
# Long random string (e.g. `openssl rand -base64 48`). Changing it signs everyone out.
JWT_SECRET=

# ── Public URL ──
# Origin used to build invite and password-reset links in emails. Required in
# production; links are never built from the request Host header.
APP_BASE_URL=https://securetanza.example.gov.ph

# ── Outbound email (SMTP, any provider) ──
# Leave SMTP_HOST empty in development to print emails to the server console instead.
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (usually port 465); otherwise STARTTLS is used when offered.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Secure Tanza <no-reply@example.gov.ph>"

# ── Accounts ──
# Optional comma-separated allow-list for staff email domains (subdomains allowed).
# Empty = any domain.
ALLOWED_EMAIL_DOMAINS=
# Sign-in emails for the two administrators created by backend/prisma/seed-auth.ts.
SEED_ADMIN_EMAILS=

# ── Two-step verification ──
# Encrypts authenticator secrets at rest. 32 random bytes, base64:
#   openssl rand -base64 32
# Required in production. Changing or losing it means every account has to
# set up its authenticator again (run `pnpm mfa:reset <email>` per account).
MFA_ENCRYPTION_KEY=
# How long "Trust this browser" skips the code (days, fixed from when it was ticked).
MFA_TRUST_DAYS_ADMIN=30
MFA_TRUST_DAYS_STAFF=60
