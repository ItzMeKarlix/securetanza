// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  output          = "../lib/generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

/// One recorded offense with its stage of felony. Offenses are never grouped:
/// a blotter that lists several offenses is several independent records.
model Offense {
  id                  String            @id @default(cuid())
  offenseDefinitionId String            @map("offense_definition_id")
  offenseDefinition   OffenseDefinition @relation(fields: [offenseDefinitionId], references: [id])
  importKey           String?           @unique @map("import_key")
  crimeType           String            @map("crime_type")
  felonyStage         String            @default("UNKNOWN") @map("felony_stage")
  sourceFile          String?           @map("source_file")
  sourceSheet         String?           @map("source_sheet")
  sourceRow           Int?              @map("source_row")

  // Blotter Information
  blotterNo   String?   @map("blotter_no") // Blotter number
  dateEncoded DateTime? @map("date_encoded") // When record was encoded

  // Police Organization Structure
  pro String? @map("police_regional_office") // Police Regional Office
  ppo String? @map("police_provincial_office") // Police Provincial Office
  stn String? @map("station") // Police Station
  pcp String? @map("police_community_precinct") // Police Community Precinct

  // Administrative Location
  region    String?
  province  String?
  municipal String? @map("municipality")
  barangay  String
  street    String?

  // Location Details
  typeOfPlace String? @map("type_of_place") // Type of place where the offense occurred

  // Reporting Information
  dateReported DateTime @map("date_reported")
  timeReported String   @map("time_reported") // HH:MM:SS format

  // When the offense was committed
  dateCommitted DateTime @map("date_committed")
  timeCommitted String   @map("time_committed") // HH:MM:SS format
  isCrime       Boolean  @default(true) @map("is_crime") // YES/NO from iscime column

  // Process Information
  modeReporting String? @map("mode_reporting") // How the crime was reported
  stageOfFelony String? @map("stage_of_felony") // Stage of the felony

  // Legal Information
  offense     String? // Legal offense description
  offenseType String? @map("offense_type") // Type of offense (Republic Act, etc.)
  section     String? // Legal section reference

  // Crime Details
  modus            String? // Method of operation
  suspectMotive    String? @map("suspect_motive") // Motive of the suspect
  suspectSubMotive String? @map("suspect_sub_motive") // Sub-motive of the suspect

  // Crime Classification
  heinous     Boolean @default(false) // Is crime heinous
  sensational Boolean @default(false) // Is crime sensational

  // Threat Group Information
  threatGrp      Boolean @default(false) @map("threat_grp") // Threat group involvement
  grpAffiliation String? @map("grp_affiliation") // Group affiliation details
  mrs            String? // MRS field

  // Suspect Information
  suspectIsEGO       Boolean  @default(false) @map("suspect_is_ego") // Is suspect elected/government official
  suspectEGOPosition String?  @map("suspect_ego_position") // Suspect's government position
  suspectEGOClass    String?  @map("suspect_ego_class") // Suspect's government class
  suspectCount       Int?     @map("suspect_count") // Number of suspects
  suspectArrested    Boolean? @map("suspect_arrested") // Was suspect arrested

  // Victim Information
  victimIsEGO       Boolean @default(false) @map("victim_is_ego") // Is victim elected/government official
  victimEGOPosition String? @map("victim_ego_position") // Victim's government position
  victimEGOClass    String? @map("victim_ego_class") // Victim's government class
  victimCount       Int?    @map("victim_count") // Number of victims

  // Case Management
  caseStatus   String? @map("case_status") // Case status (Cleared, etc.)
  investigator String? // Assigned investigator
  headInves    String? @map("head_investigator") // Head investigator

  // Geographic Coordinates
  latitude  Float? @map("lat")
  longitude Float? @map("lng")

  // System Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([barangay])
  @@index([dateCommitted])
  @@index([offenseDefinitionId])
  @@index([crimeType, felonyStage])
  @@index([region, province, municipal])
  @@index([latitude, longitude])
  @@index([blotterNo])
  @@index([caseStatus])
  @@index([heinous])
  @@index([sensational])
  @@map("offenses")
}

model OffenseDefinition {
  id      String    @id @default(cuid())
  code    String    @unique
  label   String
  records Offense[]

  @@map("offense_definitions")
}

model Barangay {
  id          String   @id @default(cuid())
  name        String   @unique
  coordinates Json? // Store GeoJSON coordinates if needed
  population  Int?
  area        Float? // Area in square kilometers
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("barangays")
}

model AuditLog {
  id String @id @default(cuid())

  // Generic audit fields
  action    String?  @default("Import") // e.g., "Auth", "Import", "Read", "Export", "Settings"
  details   String?
  user      String?
  createdAt DateTime @default(now()) @map("created_at")

  ip        String?
  session   String?
  userAgent String? @map("user_agent")
  resource  String?
  severity  String? @default("low") // "low", "medium", "high"
  outcome   String? @default("success")

  // Specific import fields
  fileName        String? @map("file_name")
  fileSize        Int?    @map("file_size") // File size in bytes
  recordsImported Int?    @map("records_imported") // Number of records imported
  errorMessage    String? @map("error_message") // Error details if failed

  @@index([createdAt])
  @@index([outcome])
  @@index([action])
  @@map("audit_logs")
}

// Authentication and Authorization Models

model User {
  id                 Int       @id @default(autoincrement())
  accountNumber      String    @unique @map("account_number") // Immutable internal staff ID (audit logs, exports)
  // Sign-in identifier. Stored lowercase + trimmed. Nullable only while legacy
  // accounts are being given an address; those still sign in by account number.
  email              String?   @unique
  // Set when the person proves they own the address (accepts an invite or a reset link).
  emailVerifiedAt    DateTime? @map("email_verified_at")
  // Bumped whenever the password is set, reset or changed, or the account is
  // unlocked — any session minted with an older version stops working.
  sessionVersion     Int       @default(0) @map("session_version")
  fullName           String    @map("full_name")
  passwordHash       String    @map("password_hash")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  defaultLandingPage String    @default("dashboard") @map("default_landing_page")
  autoLogoutTimer    Int       @default(15) @map("auto_logout_timer")

  // Sign-in lockout. Three consecutive wrong passwords stamp lockedAt; only an
  // administrator clears it, which also issues a fresh temporary password.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedAt            DateTime? @map("locked_at")

  // Two-factor authentication (required for every account).
  // The TOTP secret is AES-256-GCM encrypted with MFA_ENCRYPTION_KEY.
  totpSecretEnc           String?   @map("totp_secret_enc")
  totpEnabledAt           DateTime? @map("totp_enabled_at")
  // Last accepted 30-second step, so a code can't be replayed.
  totpLastStep            Int?      @map("totp_last_step")
  // Consecutive wrong second-factor codes; 5 locks the account like wrong passwords do.
  mfaFailedAttempts       Int       @default(0) @map("mfa_failed_attempts")
  // Set when a password is reset through an emailed link. For 7 days after,
  // the emailed-code fallback is refused (inbox access alone must not be enough).
  passwordResetViaEmailAt DateTime? @map("password_reset_via_email_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Soft delete: set when an administrator deletes the account. It can't sign
  // in, and it's restorable until the worker purges it 30 days later.
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") // account number of the admin who deleted it

  // Relations
  permissions     UserPermission[]
  exportSchedules ExportSchedule[]
  authTokens      AuthToken[]
  mfaBackupCodes  MfaBackupCode[]
  trustedDevices  TrustedDevice[]

  @@index([accountNumber])
  @@index([deletedAt])
  @@map("users")
}

/**
 * One-time links emailed to staff: an invite to set a first password, or a
 * password reset. Only the SHA-256 of the token is stored; the raw value
 * exists solely in the email that was sent.
 */
model AuthToken {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  purpose     String // "invite" | "reset"
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdById Int?      @map("created_by_id") // Admin who triggered it; null for self-service

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

/**
 * A retained copy of exported data, held in the database rather than on disk so it
 * survives redeploys and container restarts. Content is the finished file itself —
 * an .xlsx snapshot of the register, or a generated PDF report.
 */
model Backup {
  id          String    @id @default(cuid())
  kind        String // "crime_data" | "report" | "scheduled_export"
  fileName    String    @map("file_name")
  mimeType    String    @map("mime_type")
  sizeBytes   Int       @map("size_bytes")
  content     Bytes // the file itself
  label       String? // human summary, e.g. "All Barangays"
  barangay    String? // scope, when the snapshot is narrowed
  periodLabel String?   @map("period_label") // e.g. "Year 2026", "Q1 2026"
  rowCount    Int?      @map("row_count") // offenses captured, for data snapshots
  createdBy   String    @map("created_by") // account number, or "system" for cron
  createdAt   DateTime  @default(now()) @map("created_at")
  // Soft delete: hidden and restorable for 30 days, then purged by the worker.
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by") // account number, or "system" for retention

  @@index([kind])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("backups")
}

model ExportSchedule {
  id            String    @id @default(cuid())
  userId        Int       @map("user_id")
  enabled       Boolean   @default(false)
  frequency     String    @default("weekly") // "daily", "weekly", "monthly"
  dayOfWeek     String?   @map("day_of_week") // e.g., "Monday"
  dayOfMonth    String?   @map("day_of_month") // e.g., "1"
  monthlyOn     String?   @map("monthly_on") // Day of year for annually if needed
  timeOfDay     String?   @map("time_of_day") // e.g. "14:30", station time (UTC+8)
  // Run bookkeeping (backend/cron/worker.ts). Occurrences before savedAt never
  // run, so saving a schedule doesn't fire one immediately for a time already passed.
  savedAt       DateTime? @map("saved_at")
  lastRunAt     DateTime? @map("last_run_at") // last successful export
  lastAttemptAt DateTime? @map("last_attempt_at") // last start, successful or not
  lastRunError  String?   @map("last_run_error")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("export_schedules")
}

model Permission {
  id             Int     @id @default(autoincrement())
  permissionName String  @unique @map("permission_name") // e.g., "admin", "operational_officer", "privileged_user"
  description    String?

  // Relations
  users UserPermission[]

  @@map("permissions")
}

model UserPermission {
  userId       Int      @map("user_id")
  permissionId Int      @map("permission_id")
  assignedBy   Int?     @map("assigned_by") // User ID who assigned this permission
  assignedAt   DateTime @default(now()) @map("assigned_at")

  // Relations
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
  @@map("user_permissions")
}

/**
 * One-time recovery codes for two-factor sign-in (bcrypt hashes; regenerating replaces the set).
 */
model MfaBackupCode {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_backup_codes")
}

/**
 * A browser the person chose to trust, so the second factor is skipped there
 * until expiresAt. Bound to the user's sessionVersion at the time: any password
 * change, unlock or 2FA reset invalidates it.
 */
model TrustedDevice {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  tokenHash      String    @unique @map("token_hash")
  sessionVersion Int       @map("session_version")
  label          String
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime  @map("expires_at")
  lastUsedAt     DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("trusted_devices")
}
